{
  "name": "Offset Well Webtool",
  "image": "mcr.microsoft.com/devcontainers/python:3.13-bookworm",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Offset Well Webtool",
      "onAutoForward": "openBrowser"
    }
  },
  "secrets": {
    "ANTHROPIC_API_KEY": {
      "description": "Optional. Claude API key for scanned survey pages and New Mexico plat pages."
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
